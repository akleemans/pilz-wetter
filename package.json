{
  "name": "pilz-wetter",
  "version": "2.0.0",
  "private": true,
  "description": "Pilzwetter — weather history and forecast for the canton of Bern, scored for mushroom foraging",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .hooks",
    "dev": "bun --port 8080 ./index.html ./scenarios.html",
    "build": "bun scripts/build.ts",
    "preview": "bunx serve docs/ -l 8080",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "scenarios": "bun scripts/scenarios.ts",
    "observations": "bun scripts/observations.ts",
    "docs:params": "bun scripts/param-docs.ts"
  },
  "dependencies": {
    "echarts": "5.6.0"
  },
  "devDependencies": {
    "@nkzw/oxlint-config": "2.0.1",
    "@types/bun": "1.3.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "5.9.3"
  }
}
